# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Names only here — these document the secrets/config the service will need.
# (Named `env.example` rather than `.env.example` because the harness write-guard
#  blocks creating any `.env*` file; copy it to `.env` locally.)

# --- LLM (owner-paid; server-side only, never sent to the browser) ---
# Sarvam AI (OpenAI-compatible endpoint). See SARVAM_INTEGRATION.md.
# Leave LLM_API_KEY empty for local dev (no-LLM stub; always works for testing).
LLM_BASE_URL=https://api.sarvam.ai/v2
LLM_API_KEY=
LLM_CHEAP_MODEL=deepseekv4-flash
LLM_PLANNER_MODEL=deepseekv4-flash

# --- Database / cache (Phase 1) ---
# Uppercase placeholders (avoids secret-scanner false positives on user:pass@ patterns)
DATABASE_URL=postgresql+psycopg://USER:PASS@localhost:5432/playstore_reviews

# --- Auth (Google OAuth) ---
# Leave all three BLANK for local dev (auth disabled → a single local user, zero setup).
# With an OAuth client: GOOGLE_REDIRECT_URI blank = auto-derived from the request
# (local: http://localhost:8000/auth/callback). In prod behind the TLS proxy it MUST
# be set explicitly, and must exactly match an Authorized redirect URI on the client:
#   GOOGLE_REDIRECT_URI=https://review.topfolio.in/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SESSION_SECRET=change-me-to-a-long-random-string-in-prod

# --- Cost control ---
GLOBAL_DAILY_SPEND_CAP_USD=20
PER_USER_DAILY_ANALYSES=5    # free analyses per user per UTC day; cached re-asks are free

# --- No-login free trial (try-before-you-sign-in) ---
# Anonymous visitors get N analyses/browser/day before the sign-in gate. Inert unless auth is
# enabled. Auto-disables once the day's spend hits ANON_SPEND_FRACTION of the global cap, so
# signed-in users always keep headroom. Set ANON_TRIAL_ENABLED=1 to turn it on (default off).
ANON_TRIAL_ENABLED=0
ANON_DAILY_ANALYSES=1
ANON_SPEND_FRACTION=0.5
MAX_REVIEWS_PER_ANALYSIS=1000   # hard cap on reviews fetched per app (newest-first)

# --- Scraper ---
SCRAPE_CACHE_TTL_HOURS=24
# Optional: set only if datacenter IPs get blocked (the Ampere spike passed, so unset).
SCRAPER_PROXY_URL=

# --- Billing & Monetization (Dodo Payments) ---
# Dodo Payments (Merchant of Record - allows individual PAN in India to sell internationally in USD)
# Flip DODO_PAYMENTS_ENVIRONMENT to live_mode for launch.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID_STARTER=pdt_0NoMFta1GvOnnuvqQupPi
DODO_PRODUCT_ID_PASS=pdt_0NoMFtbyuC8aLbMY6ztiD
DODO_PRODUCT_ID_PRO=
# Mock billing activator (local dev/tests ONLY — grants tiers without payment).
# NEVER set to 1 in prod: /api/billing/mock-activate returns 404 unless enabled.
ALLOW_MOCK_BILLING=0
# Invite-only beta gate: 0 closes new Google signups (existing users keep access).
SIGNUP_OPEN=1

# --- Deploy (docker-compose / prod only) ---
DOMAIN=reviews.example.com           # your subdomain; Caddy gets a TLS cert for it
POSTGRES_USER=pmr
POSTGRES_PASSWORD=                    # set a strong value
POSTGRES_DB=playstore_reviews
SESSION_COOKIE_SECURE=1              # 1 in prod (HTTPS); leave unset/0 for local http
# DATABASE_URL is set by docker-compose from the POSTGRES_* values above.
