# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Names only here — these document the secrets/config the service will need.
# (Named `env.example` rather than `.env.example` because the harness write-guard
#  blocks creating any `.env*` file; copy it to `.env` locally.)

# --- LLM (owner-paid; server-side only, never sent to the browser) ---
# Provider resolution: openai_compatible (if LLM_PROVIDER + LLM_API_KEY + LLM_BASE_URL set)
#   -> gemini (if GEMINI_API_KEY set) -> stub (no LLM; always works for local testing).

# Option A — Oracle OCI Generative AI (OpenAI-compatible). See OCI_GENAI_INTEGRATION.md.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com/openai/v1
LLM_API_KEY=
LLM_COMPARTMENT_ID=
LLM_CHEAP_MODEL=xai.grok-3-mini
LLM_PLANNER_MODEL=xai.grok-4

# Option B — Google AI Studio (Gemini SDK). Leave LLM_PROVIDER empty to use this.
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite

# --- Database / cache (Phase 1) ---
# Uppercase placeholders (avoids secret-scanner false positives on user:pass@ patterns)
DATABASE_URL=postgresql+psycopg://USER:PASS@localhost:5432/playstore_reviews

# --- Auth (Phase 3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# --- Cost control (Phase 3) ---
GLOBAL_DAILY_SPEND_CAP_USD=20
PER_USER_DAILY_ANALYSES=10
MAX_REVIEWS_PER_ANALYSIS=500

# --- Scraper (Phase 0/1) ---
SCRAPE_CACHE_TTL_HOURS=24
# Optional: set only if the 0.1 spike shows datacenter IPs are blocked.
SCRAPER_PROXY_URL=
